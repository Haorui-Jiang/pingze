# 环境变量示例 —— 复制为 .env 后填入真实值（.env 永不入库）
#
# V5（2026-10-16）起口径变化：
#   · 平仄 / 韵部 / 重字查询 = 浏览器本地查表（结果/pingze-engine.js），
#     不经过本服务、不消耗任何密钥与配额；
#   · 只有「AI 平仄分析 / 诗词鉴赏」才需要 DeepSeek 密钥，且必须登录、
#     按次计配额（免费 3 次/天、会员 10 次/天，配额在数据库侧，
#     见 supabase/migrations/0007_v5_query_engine.sql，不通过环境变量配置）。

# ---------- DeepSeek 接口配置（仅 AI 赏析需要） ----------
DEEPSEEK_API_KEY=你的_DeepSeek_API_Key
# 模型选择（2026-10-16 线上 504 事故后调整）：
#   deepseek-chat   非推理型，同题约 1.6s 返回 —— 默认，Serverless 唯一可行选项
#   deepseek-flash  推理型（V4.1-Flash），每次先思考 2000-4000 tokens，
#                   单次 14-26s，会越过 Netlify 时限被网关杀成 504，勿在线上使用
# 展示名 DeepSeek-V4.1-Flash 由服务端映射为接口实际 ID：deepseek-flash
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# AI 单次调用的超时预算（毫秒）。2026-10-16 起重写为「全函数总预算」：
# 冷启动 + Supabase 往返 + 模型调用 + 序列化都从这算，任何阶段超时都在
# 平台杀进程之前返回结构化 JSON 错误（而不是 504 空响应）。
# 总预算 = min(FUNCTION_TIMEOUT_MS, PLATFORM_LIMIT_MS - 500ms 余量)
FUNCTION_TIMEOUT_MS=8000
# 部署平台对同步函数的硬限时（Netlify 免费版 10s；Pro 可到 26s）
PLATFORM_LIMIT_MS=10000
# Supabase 单次请求超时（毫秒），防止卡住吃掉 AI 接口的整个预算
SUPABASE_TIMEOUT_MS=5000

# 本地服务端口
PORT=3000

# ---------- Supabase 连接配置（服务端） ----------
# 只填项目根地址，不要带 /rest/v1 后缀（脚本会自动拼接，重复会变成 /rest/v1/rest/v1 导致 404）
SUPABASE_URL=https://your-project.supabase.co

# service_role key，绕过 RLS、具备全库权限。
# 只能出现在服务端环境与 sb.py 里，绝对不要下发到前端。
SUPABASE_SERVICE_KEY=你的_service_role_key

# ---------- 后台管理（/admin）管理员白名单 ----------
# 仅下列邮箱（逗号分隔，大小写不敏感）可登录管理后台浏览用户数据。
# 对应需求「仅限 Supabase 项目管理员账号」。未配置时 fail-closed：任何人都进不去。
# 需同时在 Netlify → Site settings → Environment variables 中设置（Serverless 函数运行时读取）。
ADMIN_EMAILS=admin@example.com

# ---------- 注册限流 ----------
# 站点开着邮箱确认时，Supabase 默认 SMTP 限 2 封/小时，注册会直接 429。
# 因此注册改由后端用 service_role 建号（email_confirm=true，不发邮件），
# 代价是邮箱真实性不校验，靠下面两个值防刷。接了自定义 SMTP 后可恢复邮箱确认。
REGISTER_MAX_PER_IP=3      # 单个 IP 每小时最多注册几个（进程内计数，Serverless 上为尽力而为）
REGISTER_MAX_PER_HOUR=50   # 全站每小时最多新增多少账号（查 profiles 计数，跨实例有效）

# ---------- 前端（浏览器） ----------
# 需要填到 结果/supabase-config.js，而不是这里 —— 浏览器读不到 .env
# 那里只能填 anon key，绝不能填 service_role key
# SUPABASE_ANON_KEY=你的_anon_public_key

# ---------- Supabase CLI（命令行） ----------
# 拿 token：Dashboard → 右上角头像 → Account Preferences → Access Tokens → Generate new token
# 用途：supabase link / db push / functions deploy / projects list（管理类操作）
#       纯 SQL 查询与 Edge Function 运行不需要它。
# 本机开发时 CLI 只读 shell 环境变量，不会自动读本文件，需要先 export（见 README 备注）。
# 留空不影响站点运行，只是 CLI 的管理类命令会提示 "Access token not provided"。
# SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
