# DeepSeek 接口配置示例 —— 复制为 .env 后填入真实值
DEEPSEEK_API_KEY=你的_DeepSeek_API_Key
DEEPSEEK_MODEL=DeepSeek-V4.1-Flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 本地服务端口
PORT=3000

# 等待大模型响应的超时（毫秒）
REQUEST_TIMEOUT_MS=55000

# ---------- Supabase 连接配置（服务端） ----------
# 只填项目根地址，不要带 /rest/v1 后缀（脚本会自动拼接，重复会变成 /rest/v1/rest/v1 导致 404）
SUPABASE_URL=https://your-project.supabase.co

# service_role key，绕过 RLS、具备全库权限。
# 只能出现在服务端环境与 sb.py 里，绝对不要下发到前端。
SUPABASE_SERVICE_KEY=你的_service_role_key

# ---------- 后台管理（/admin）管理员白名单 ----------
# 仅下列邮箱（逗号分隔，大小写不敏感）可登录管理后台浏览用户数据。
# 对应需求「仅限 Supabase 项目管理员账号」。未配置时 fail-closed：任何人都进不去。
# 需同时在 Netlify → Site settings → Environment variables 中设置（Serverless 函数运行时读取）。
ADMIN_EMAILS=admin@example.com

# ---------- 是否必须登录才能分析 ----------
# 默认规则：配了 Supabase 就要求登录（算力和 token 都是真金白银）。
# 想放开匿名使用设 REQUIRE_LOGIN=0，此时下面的 ANON_DAILY_QUOTA 才生效。
REQUIRE_LOGIN=1

# ---------- 配额 / 会员（付费功能）----------
# 未登录访客每日可分析次数（按 IP+UA 哈希识别，换网络/ip 即可绕过，够用即可）
# 仅当 REQUIRE_LOGIN=0 时有效
ANON_DAILY_QUOTA=5

# 会员体系每日配额。必须与数据库 usage_today() 保持一致
# （见 supabase/0006_membership.sql），漏改一处会出现
# 「前端显示 1、后端按 10 放行」的错配。
#   free   免费用户（默认）
#   member 有效会员（tier=member 且 member_expires_at 未过期）
QUOTA_FREE=1
QUOTA_MEMBER=10

# ---------- 注册限流 ----------
# 站点开着邮箱确认时，Supabase 默认 SMTP 限 2 封/小时，注册会直接 429。
# 因此注册改由后端用 service_role 建号（email_confirm=true，不发邮件），
# 代价是邮箱真实性不校验，靠下面两个值防刷。接了自定义 SMTP 后可恢复邮箱确认。
REGISTER_MAX_PER_IP=3      # 单个 IP 每小时最多注册几个（进程内计数，Serverless 上为尽力而为）
REGISTER_MAX_PER_HOUR=50   # 全站每小时最多新增多少账号（查 profiles 计数，跨实例有效）

# ---------- 前端（浏览器） ----------
# 需要填到 结果/supabase-config.js，而不是这里 —— 浏览器读不到 .env
# 那里只能填 anon key，绝不能填 service_role key
# SUPABASE_ANON_KEY=你的_anon_public_key
